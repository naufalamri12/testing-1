def secret = 'ubuntu'
def server = 'ubuntu@ip-172-31-12-214'
def directory = '~/dumbflix-frontend'
def branch = 'main'
def image = 'dumbflix-frontend:latest'

pipeline {
    agent any

    stages {

        stage('Pulling New Code') {
            steps {
                sshagent([secret]) {
                    sh """ssh -o StrictHostKeyChecking=no ${server} << EOF
                    cd ${directory}
                    git reset --hard HEAD
                    git pull origin ${branch}
                    exit
                    EOF"""
                }
            }
        }

        stage('Build Apps') {
            steps {
                sshagent([secret]) {
                    sh """ssh -o StrictHostKeyChecking=no ${server} << EOF
                    cd ${directory}
                    docker build -t ${image} .
                    exit
                    EOF"""
                }
            }
        }

        stage('Test Application') {
            steps {
                sshagent([secret]) {
                    sh """ssh -o StrictHostKeyChecking=no ${server} << EOF
                    cd ${directory}
                    docker run --rm ${image} npm test
                    exit
                    EOF"""
                }
            }
        }

        stage('Deploy Application') {
            steps {
                sshagent([secret]) {
                    sh """ssh -o StrictHostKeyChecking=no ${server} << EOF
                    cd ${directory}
                    docker compose down
                    docker compose up -d --build
                    exit
                    EOF"""
                }
            }
        }
    }
}
